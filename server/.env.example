# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=3001

# MySQL (cPanel: create via "MySQL Databases", user must be added to the DB with privileges)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zexora_app
DB_PASSWORD=
DB_NAME=zexora_cms
DB_CONNECTION_LIMIT=10

# Comma-separated list of allowed origins for CORS (only needed if the
# frontend is ever served from a different origin than the API).
CORS_ORIGIN=http://localhost:3000

# Session (Phase 3)
SESSION_SECRET=change-me-to-a-long-random-string

# Mail (Phase 8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@zexora.com.bd
MAIL_TO=info@zexora.com.bd

# SEO (Phase 9) - used for canonical/OG URLs and the generated sitemap.xml
SITE_URL=https://zexora.com.bd
